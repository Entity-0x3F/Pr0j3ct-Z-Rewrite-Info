<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hypnotic Red & Gold Pulse</title>
    <style>
        :root {
            --bg-color: #000000;
            --ring-color: #7a0000;
            --accent-red: #ff0000;
            --blood-red: #ff0000; 
            --gold-color: #ffd700;
            --gold-glow: #ffae00;
            --gold-dark: #b8860b;
            --transition-speed: 2s;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: var(--bg-color);
            overflow: hidden;
            font-family: 'Georgia', 'Times New Roman', serif;
            transition: background-color var(--transition-speed) ease;
        }

        /* Scanline Overlay */
        body::after {
            content: " ";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 3px 100%;
            z-index: 500;
            pointer-events: none;
            opacity: 0.3;
        }

        .canvas-wrapper {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at center, #300 0%, #000 80%);
            transition: background var(--transition-speed) ease;
        }

        body.love-mode .canvas-wrapper {
            background: radial-gradient(circle at center, #750 0%, #320 80%, #110 100%);
        }

        .ring-container {
            position: absolute;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: slow-rotate 30s linear infinite;
        }

        .ring {
            position: absolute;
            border: 15px solid var(--ring-color);
            border-radius: 50%;
            box-shadow: 0 0 40px rgba(138, 3, 3, 0.3);
            animation: hypnotic-pulse 6s ease-in-out infinite;
            transition: border-color 0.1s ease, box-shadow 0.1s ease, opacity 0.8s ease;
        }

        /* Flash State for Impact */
        .ring.flash-gold {
            border-color: var(--gold-color) !important;
            box-shadow: 0 0 60px var(--gold-glow), inset 0 0 20px var(--gold-glow) !important;
            transition: border-color 0.05s ease, box-shadow 0.05s ease;
        }

        .shiver {
            animation: ring-shiver 0.1s infinite !important;
            border-color: var(--gold-glow) !important;
            box-shadow: 0 0 50px var(--gold-glow) !important;
        }

        body.love-mode .ring {
            border-color: var(--gold-color) !important;
            box-shadow: 0 0 100px var(--gold-glow) !important;
            filter: brightness(1.5);
            animation: hypnotic-pulse 6s ease-in-out infinite !important; 
        }

        .ring:nth-child(1) { width: 220px; height: 220px; animation-delay: 0s; border-width: 10px; z-index: 10; }
        .ring:nth-child(2) { width: 480px; height: 480px; animation-delay: -1.5s; border-width: 20px; opacity: 0.6; }
        .ring:nth-child(3) { width: 800px; height: 800px; animation-delay: -3s; border-width: 35px; opacity: 0.3; }
        .ring:nth-child(4) { width: 1200px; height: 1200px; animation-delay: -4.5s; border-width: 50px; opacity: 0.1; }

        .energy-container {
            position: absolute;
            z-index: 100;
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        #energy-ball {
            fill: var(--gold-color);
            filter: drop-shadow(0 0 20px var(--gold-glow));
            transition: fill 1s ease, opacity 0.5s ease;
        }

        #shatters {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 150;
        }

        #haunting-text-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 200;
            pointer-events: none;
        }

        #haunting-text {
            color: var(--blood-red);
            font-weight: 900;
            text-transform: uppercase;
            text-align: center;
            padding: 20px;
            letter-spacing: 1px;
            opacity: 0;
            font-size: clamp(1.8rem, 8vw, 4.5rem);
            max-width: 90vw;
            text-shadow: 0 0 15px rgba(255, 0, 0, 0.9), 0 0 5px rgba(0, 0, 0, 1);
            transition: color 1.5s ease, text-shadow 1.5s ease;
        }

        body.love-mode #haunting-text {
            color: #ccac00 !important;
            text-shadow: 
                0 0 5px #000,
                0 0 10px #000,
                0 0 25px var(--gold-glow),
                0 0 50px rgba(255, 215, 0, 0.3) !important;
        }

        .glitch-active {
            opacity: 1 !important;
            animation: tiktok-shake 0.12s infinite;
        }

        @keyframes ring-shiver {
            0% { transform: translate(0) scale(1); }
            25% { transform: translate(-6px, 6px) scale(1.02); }
            50% { transform: translate(6px, -6px) scale(0.98); }
            75% { transform: translate(-6px, -6px) scale(1.02); }
            100% { transform: translate(0) scale(1); }
        }

        @keyframes tiktok-shake {
            0% { transform: translate(0); }
            25% { transform: translate(-3px, 2px); }
            50% { transform: translate(3px, -2px); }
            100% { transform: translate(0); }
        }

        @keyframes hypnotic-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes slow-rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="hate-mode">

    <div class="canvas-wrapper" id="master-wrap">
        <div id="shatters"></div>
        <div class="ring-container" id="ring-box">
            <div class="ring" id="inner-ring"></div>
            <div class="ring"></div>
            <div class="ring"></div>
            <div class="ring"></div>
        </div>
        
        <div id="haunting-text-container">
            <div id="haunting-text" data-text=""></div>
        </div>

        <div class="energy-container" id="energy-wrap">
            <svg width="220" height="220" viewBox="0 0 220 220">
                <circle id="energy-ball" cx="110" cy="110" r="12" />
            </svg>
        </div>
    </div>

    <script>
        const ball = document.getElementById('energy-ball');
        const textElement = document.getElementById('haunting-text');
        const energyWrap = document.getElementById('energy-wrap');
        const masterWrap = document.getElementById('master-wrap');
        const innerRing = document.getElementById('inner-ring');
        const shatterContainer = document.getElementById('shatters');
        const allRings = document.querySelectorAll('.ring');
        
        const hatePhrases = [
            "You Lost Him", "You Ruined Everything", "This Is Your Fault", "He Doesn't Love You Anymore", "Accept Your Fate",
            "He's Moved On", "He's Happier Without You", "You Know He's With Someone Else", "You Hurt Him", "You Did This",
            "You're Pathetic", "He'd Never Love You", "He Can't Hear Your Plea For Help", "Just Stop Breathing Already",
            "You'll Die Without Him By Your Side", "Another Failure", "Your Love Is a Toxin No One Wants",
        ];

        const lovePhrases = [
            "Forgive Yourself.. Please", "I Still Remember You", "Listen To Me..", "We Can Do This Together..",
            "I Could Never Hate You..", "You'll Always Be Mine..", "I Forgive You..", "I Love You more..",
            "I'm Still Here Aren't I Babes..", "I'll Never Leave Your Side..", "Forever And Always..",
        ];

        let t = 0;
        let figure8T = 0;
        let instability = 1; 
        let isLoveMode = false;
        let isVanishing = false;
        let risingAggression = false;
        let aggressionStartTime = 0;
        let loveModeStartTime = 0;
        let loveModeTargetDuration = 0;
        let textTimer = null;
        
        let isImpacting = false;
        let impactT = 0;
        let targetX = 110;
        let targetY = 110;

        function createShatterEffect() {
            shatterContainer.innerHTML = '';
            for(let i=0; i<60; i++) {
                const shard = document.createElement('div');
                shard.style.position = 'absolute';
                shard.style.width = Math.random() * 60 + 30 + 'px';
                shard.style.height = '6px';
                shard.style.background = 'var(--gold-color)';
                shard.style.boxShadow = '0 0 25px var(--gold-glow)';
                shard.style.left = '50%';
                shard.style.top = '50%';
                shard.style.borderRadius = '2px';
                
                const angle = Math.random() * Math.PI * 2;
                const dist = 600 + Math.random() * 800;
                const tx = Math.cos(angle) * dist;
                const ty = Math.sin(angle) * dist;
                const rot = Math.random() * 1080;

                shard.animate([
                    { transform: 'translate(-50%, -50%) rotate(0deg) scale(1)', opacity: 1 },
                    { transform: `translate(${tx}px, ${ty}px) rotate(${rot}deg) scale(0)`, opacity: 0 }
                ], {
                    duration: 1800,
                    easing: 'cubic-bezier(0.1, 0.9, 0.2, 1)',
                    fill: 'forwards'
                });
                shatterContainer.appendChild(shard);
            }
        }

        function animateEnergy() {
            t += 0.05;
            figure8T += 0.045; 

            const midX = 110;
            const midY = 110;
            
            const idleAmpX = 45;
            const idleAmpY = 25;
            const idleX = Math.sin(figure8T) * idleAmpX;
            const idleY = (Math.sin(2 * figure8T) / 2) * (idleAmpY * 1.5);

            let radius = 10 + Math.sin(t * 2) * 2 + (instability * 0.8);
            let currentX = midX + idleX;
            let currentY = midY + idleY;

            if (!isLoveMode) {
                const shakeIntensity = (instability - 1) * 3;
                const shakeX = (Math.random() - 0.5) * shakeIntensity;
                const shakeY = (Math.random() - 0.5) * shakeIntensity;

                if (!isImpacting && !isVanishing && Math.random() < 0.01 * instability) {
                    isImpacting = true;
                    impactT = 0;
                    const angle = Math.random() * Math.PI * 2;
                    targetX = midX + Math.cos(angle) * 102; 
                    targetY = midY + Math.sin(angle) * 102;
                }

                if (isImpacting) {
                    impactT += 0.14 + (instability * 0.03); 
                    
                    if (impactT > Math.PI) {
                        isImpacting = false;
                        innerRing.classList.remove('shiver');
                        innerRing.classList.remove('flash-gold');
                    } else {
                        const progress = Math.sin(impactT);
                        currentX = (midX + idleX) * (1 - progress) + targetX * progress;
                        currentY = (midY + idleY) * (1 - progress) + targetY * progress;
                        
                        // Flash gold only during the peak of the contact
                        if (progress > 0.9) {
                            innerRing.classList.add('flash-gold');
                            innerRing.classList.add('shiver');
                        } else {
                            innerRing.classList.remove('flash-gold');
                            innerRing.classList.remove('shiver');
                        }
                        radius = radius * (1 + progress * 0.4);
                    }
                }
                currentX += shakeX;
                currentY += shakeY;
            } else if (isVanishing) {
                radius += 15;
                ball.style.opacity = Math.max(0, parseFloat(ball.style.opacity || 1) - 0.05);
            }
            
            ball.setAttribute('cx', currentX);
            ball.setAttribute('cy', currentY);
            ball.setAttribute('r', radius);

            requestAnimationFrame(animateEnergy);
        }

        function showRandomText() {
            if (textTimer) clearTimeout(textTimer);
            
            const currentPhrases = isLoveMode ? lovePhrases : hatePhrases;
            const phrase = currentPhrases[Math.floor(Math.random() * currentPhrases.length)];
            textElement.textContent = phrase;
            textElement.setAttribute('data-text', phrase);
            
            if (!isLoveMode) {
                textElement.classList.add('glitch-active');
                textTimer = setTimeout(() => {
                    textElement.classList.remove('glitch-active');
                    textTimer = setTimeout(showRandomText, 500 + Math.random() * 1000);
                }, 3000);
            } else {
                textElement.style.opacity = 1;
                textElement.classList.remove('glitch-active');
                
                textTimer = setTimeout(() => {
                    const loveElapsed = (Date.now() - loveModeStartTime) / 1000;
                    if (loveElapsed >= loveModeTargetDuration) {
                        resetToHate();
                    } else {
                        textElement.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 1500, fill: 'forwards' });
                        textTimer = setTimeout(() => {
                            textElement.style.opacity = 0;
                            showRandomText();
                        }, 2000);
                    }
                }, 4000);
            }
        }

        function updateCycle() {
            if (!isLoveMode) {
                if (!risingAggression) {
                    if (Math.random() < (1 / 2500)) {
                        risingAggression = true;
                        aggressionStartTime = Date.now();
                    }
                } else {
                    const elapsed = (Date.now() - aggressionStartTime) / 1000;
                    const duration = 300; 
                    instability = Math.min(8, 1 + (elapsed / duration) * 7);
                    if (elapsed >= duration) {
                        triggerLoveMode();
                    }
                }
            }
        }

        function triggerLoveMode() {
            if (isLoveMode) return;
            isLoveMode = true;
            isImpacting = false;
            risingAggression = false;
            
            // Set random duration between 20 and 35 seconds
            loveModeTargetDuration = 20 + Math.random() * 15;
            loveModeStartTime = Date.now();
            
            allRings.forEach(ring => ring.classList.add('shiver'));
            
            setTimeout(() => {
                isVanishing = true;
                ball.style.opacity = '1';
                createShatterEffect();
                
                document.body.classList.add('love-mode');
                document.body.classList.remove('hate-mode');
                
                allRings.forEach(ring => ring.classList.remove('shiver'));
                
                if (textTimer) clearTimeout(textTimer);
                textElement.classList.remove('glitch-active');
                textElement.textContent = "Follow My Voice..";
                textElement.style.opacity = 1;
                
                setTimeout(() => {
                    ball.style.display = 'none';
                    showRandomText();
                }, 2000);
            }, 600);
        }

        function resetToHate() {
            masterWrap.animate([
                { opacity: 1, filter: 'brightness(1)' },
                { opacity: 0, filter: 'brightness(0)' }
            ], { duration: 3000, fill: 'forwards' });

            setTimeout(() => {
                if (textTimer) clearTimeout(textTimer);
                
                isLoveMode = false;
                isVanishing = false;
                instability = 1;
                risingAggression = false;
                
                ball.style.display = 'block';
                ball.style.opacity = '1';
                ball.setAttribute('r', 12);
                
                document.body.classList.remove('love-mode');
                document.body.classList.add('hate-mode');
                allRings.forEach(ring => ring.classList.remove('shiver'));
                
                masterWrap.animate([
                    { opacity: 0, filter: 'brightness(0)' },
                    { opacity: 1, filter: 'brightness(1)' }
                ], { duration: 1500, fill: 'forwards' });

                setTimeout(() => showRandomText(), 1500);
            }, 3000);
        }

        window.onload = () => {
            animateEnergy();
            setInterval(updateCycle, 1000); 
            setTimeout(showRandomText, 1500);
        };
    </script>
</body>
</html>
